{
  "name": "26-vac-test-bid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy-allworld.mjs 26-vac-test-bid",
    "deploy:r2": "node scripts/deploy-allworld.mjs 26-vac-test-bid",
    "deploy:worker": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute vac_test_bid_db --local --file=./migrations/0001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute vac_test_bid_db --local --file=./migrations/0002_seed_data.sql",
    "db:migrate:prod": "wrangler d1 execute vac_test_bid_db --remote --file=./migrations/0001_initial_schema.sql"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5",
    "wrangler": "^4.14.0"
  }
}
